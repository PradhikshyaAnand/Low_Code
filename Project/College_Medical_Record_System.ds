 application "College Medical Record System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form appointment_booking
		{
			displayname = "Appointment Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_details.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor
			(
				type = list	
				displayname = "Doctor"
				values  = doctor_details.ID
    			displayformat = [doctor_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_date
			(
    			type = datetime
				displayname = "Appointment Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			reason_for_visit
			(
    			type = textarea
				displayname = "Reason For Visit"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Approved","Completed","Cancelled","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			duration_minutes
			(
				type = number
				displayname = "Duration Minutes"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
    			type = text
				displayname = "Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = date
				displayname = "Created Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Created","Pending Approval","Appointment Cancelled","Appointment Approved","Appointment Rejected","Appointment Completed","Appointment Rescheduled","Appointment Closed","Appointment Follow-up Required"}
			}
		}
		form doctor_details
		{
			displayname = "Doctor Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			doctor_id
			(
    			type = autonumber
				displayname = "Doctor ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor_name
			(
    			type = name
				displayname = "Doctor Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
    			type = text
				displayname = "Specialization"
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_days
			(
				type = list	
				displayname = "Available Days"
				values = {"Monday","Thursday","Friday","Sunday","Wednesday","Tuesday","Saturday"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			qualification
			(
    			type = text
				displayname = "Qualification"
	 			row = 1
	 			column = 1   
				width = medium
			)
			experience_years
			(
				type = number
				displayname = "Experience Years"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_fee
			(
				displayname = "Consultation Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Active","On Leave","Retired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form medical_records
		{
			displayname = "Medical Records"
			success message = "Medical Records Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_details.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor
			(
				type = list	
				displayname = "Doctor"
				values  = doctor_details.ID
    			displayformat = [doctor_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			visit_date
			(
    			type = datetime
				displayname = "Visit Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			diagnosis
			(
    			type = textarea
				displayname = "Diagnosis"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			prescription
			(
    			type = textarea
				displayname = "Prescription"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			follow_up_date
			(
    			type = date
				displayname = "Follow Up Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			severity
			(
				type = picklist
				displayname = "Severity"
				values = {"Mild","Moderate","Critical","Severe"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			treatment_notes
			(
    			type = textarea
				displayname = "Treatment Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_confidential
			(
    			type = checkbox
				displayname = "Is Confidential"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Record Created","Pending Verification","Record Draft","Verified","Pending Correction","Treatment Plan Initiated","Archived","Follow Up Scheduled","Treatment Completed"}
			}
		}
		form student_details
		{
			displayname = "Student Details"
			success message = "Student Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student_id
			(
    			type = autonumber
				displayname = "Student ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
    			type = text
				displayname = "Department"
	 			row = 1
	 			column = 1   
				width = medium
			)
			year_1
			(
				type = picklist
				displayname = "Year"
				values = {"1st","3rd","2nd","4th","5th"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			gender
			(
				type = picklist
				displayname = "Gender"
				values = {"Male","Female","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			blood_group
			(
				type = picklist
				displayname = "Blood Group"
				values = {"B+","A+","AB+","B-","A-","O+","AB-","O-"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			emergency_contact
			(
    			type = phonenumber
				displayname = "Emergency Contact"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list appointment_booking_Report
		{
			displayName = "Appointment Booking Report"
			show all rows from appointment_booking    
			(
				student as "Student"
				doctor as "Doctor"
				appointment_date as "Appointment Date"
				reason_for_visit as "Reason For Visit"
				status as "Status"
				duration_minutes as "Duration Minutes"
				location as "Location"
				notes as "Notes"
				created_date as "Created Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Cancelled")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Completed")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Pending")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban appointment_booking_by_status
		{
			displayName = "Statuses"
			show all rows from appointment_booking    
			(
				student as "Student"
				doctor as "Doctor"
				appointment_date as "Appointment Date"
				reason_for_visit as "Reason For Visit"
				status as "Status"
				duration_minutes as "Duration Minutes"
				location as "Location"
				notes as "Notes"
				created_date as "Created Date"
			)
			options
			(
	 			display field = status
	 		)
		}
		list medical_records_Report
		{
			displayName = "All Medical Records"
			show all rows from medical_records    
			(
				student as "Student"
				doctor as "Doctor"
				visit_date as "Visit Date"
				diagnosis as "Diagnosis"
				prescription as "Prescription"
				follow_up_date as "Follow Up Date"
				severity as "Severity"
				treatment_notes as "Treatment Notes"
				is_confidential as "Is Confidential"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (severity == "Critical")
				fields = [severity]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (severity == "Mild")
				fields = [severity]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (severity == "Moderate")
				fields = [severity]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban medical_records_by_severity
		{
			displayName = "Severities"
			show all rows from medical_records    
			(
				student as "Student"
				doctor as "Doctor"
				visit_date as "Visit Date"
				diagnosis as "Diagnosis"
				prescription as "Prescription"
				follow_up_date as "Follow Up Date"
				severity as "Severity"
				treatment_notes as "Treatment Notes"
				is_confidential as "Is Confidential"
			)
			options
			(
	 			display field = severity
	 		)
		}
		list student_details_Report
		{
			displayName = "All Student Details"
			show all rows from student_details    
			(
				student_id as "Student ID"
				student_name  as "Student Name"
				department as "Department"
				year_1 as "Year"
				phone_number as "Phone Number"
				email as "Email Address"
				gender as "Gender"
				blood_group as "Blood Group"
				emergency_contact as "Emergency Contact"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (gender == "Female")
				fields = [gender]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (gender == "Male")
				fields = [gender]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (gender == "Other")
				fields = [gender]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban student_details_by_blood_group
		{
			displayName = "Blood Groups"
			show all rows from student_details    
			(
				student_id as "Student ID"
				student_name  as "Student Name"
				department as "Department"
				year_1 as "Year"
				phone_number as "Phone Number"
				email as "Email Address"
				gender as "Gender"
				blood_group as "Blood Group"
				emergency_contact as "Emergency Contact"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
			options
			(
	 			display field = blood_group
	 		)
		}
		list doctor_details_Report
		{
			displayName = "Doctor Details Report"
			show all rows from doctor_details    
			(
				doctor_id as "Doctor ID"
				doctor_name  as "Doctor Name"
				specialization as "Specialization"
				available_days as "Available Days"
				phone_number as "Phone Number"
				email as "Email Address"
				qualification as "Qualification"
				experience_years as "Experience Years"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Retired")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
			)
		}
		kanban doctor_details_by_status
		{
			displayName = "Statuses"
			show all rows from doctor_details    
			(
				doctor_id as "Doctor ID"
				doctor_name  as "Doctor Name"
				specialization as "Specialization"
				available_days as "Available Days"
				phone_number as "Phone Number"
				email as "Email Address"
				qualification as "Qualification"
				experience_years as "Experience Years"
				consultation_fee as "Consultation Fee"
				(
					display = total,average,min,max	
				)
				status as "Status"
			)
			options
			(
	 			display field = status
	 		)
		}
	}
	pages
	{
		page DashBoard

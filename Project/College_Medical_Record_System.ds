		workflow
		{
		form
		{
			notify_on_doctor_status_change as "Notify on Doctor Status Change"
			{
				type =  form
				form = doctor_details

				record event = on edit

				on user input of status
				{
					actions 
					{
						custom deluge script
						(
											// Check if the doctor status has changed to 'On Leave'
										if(input.status == "On Leave")
										{
											// Fetch the doctor record to get the doctor's name
											doctorRecord = doctor_details[ID == input.ID];
											// Prepare the notification message
											doctorName = doctorRecord.doctor_name.first_name.concat(" ").concat(doctorRecord.doctor_name.last_name);
											message = "<p>Dear Admin,</p>" + "<p>The doctor <strong>" + doctorName + "</strong> has been set to <strong>On Leave</strong> status.</p>" + "<p>Please review the doctor's schedule and update accordingly.</p>";
											// Send notification to admin
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Doctor Status Update: On Leave"
												message :message
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			send_followup_reminder_email as "Send Follow-up Reminder Email"
			{
				type =  schedule
				form = medical_records
					status = inactive
				start = follow_up_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Check if the visit severity is severe
										if(input.severity == "Critical")
										{
											// Fetch the student record using the multi-select lookup
											studentRecords = student_details[ID in input.student];
											// Iterate through each student in the multi-select lookup
											for each  student in studentRecords
											{
												// Check if student email is not null or empty
												if(student.email.isNull() == false)
												{
													// Send email to the student about follow-up date
													sendmail
													[
														from :zoho.loginuserid
														to :input.student.email
														subject :"Important: Follow-Up Appointment Reminder"
														message :"Dear " + input.student.student_name.first_name + ",\n\nThis is a reminder that you have a follow-up appointment scheduled for " + input.follow_up_date.text("dd-MMM-yyyy") + ".\n\nPlease ensure you attend this appointment as your recent visit was classified as severe.\n\nBest regards,\nMedical Records Team"
													]
												}
											}
										}
					)
					}
				}
			}
		}



 * Generated on : 21-Oct-2026 00:32:16
 * Version      : 1.0
 */
 application "Event Registration & Participant Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Event_Registration_Form
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Participant_Name
			(
    			type = name
				displayname = "Participant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Institution_Address
			(
    			type = address
				displayname = "Institution Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Organization_Name
			(
    			type = text
				displayname = "Organization Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expectations_from_Event
			(
    			type = textarea
				displayname = "Expectations from Event"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Team_Size
			(
				type = number
				displayname = "Team Size"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Session_Date
			(
    			type = date
				displayname = "Preferred Session Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Session_Slot
			(
    			type = time
				displayname = "Preferred Session Slot"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Event_Track
			(
				type = picklist
				displayname = "Event Track"
				maxchar = 100
				values = {"AIML","Web Development","Cybersecurity","IoT"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Participant_Type
			(
				type = radiobuttons
				displayname = "Participant Type"
				maxchar = 100
				values = {"Student","Faculty","Professional"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Areas_of_Interest
			(
				type = list	
				displayname = "Areas of Interest"
				values = {"AI/ML","Web Development","Cybersecurity","IoT","Robotics"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agree_to_Code_of_Conduct
			(
				type = checkboxes	
				displayname = "Agree to Code of Conduct"
				values = {"I agree to the code of conduct"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				maxchar = 100
				values = {"Pending","Paid"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Attendance_Status
			(
				type = picklist
				displayname = "Attendance Status"
				maxchar = 100
				values = {"Not Marked","Present","Absent"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Kit_Collected
			(
    			type = checkbox
				displayname = "Kit Collected"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending Payment","Confirmed","Checked-In","No Show"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list All_Registrations_List
		{
			displayName = "All_Registrations_List"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Organization_Name as "Organization Name"
				Expectations_from_Event as "Expectations from Event"
				Team_Size as "Team Size"
				Preferred_Session_Date as "Preferred Session Date"
				Preferred_Session_Slot as "Preferred Session Slot"
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Areas_of_Interest as "Areas of Interest"
				Agree_to_Code_of_Conduct as "Agree to Code of Conduct"
			)
		}
		list Payment_Status_Report
		{
			displayName = "Payment Status Report"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
	 			(
	      			displayformat = [first_name+""+last_name]
	 			)
				Email
				Contact_Number as "Contact Number"
				(
					displayformat = formattednumber 
				)
				Organization_Name as "Organization Name"
				Payment_Status as "Payment Status"
				Status
				Attendance_Status as "Attendance Status"
				Kit_Collected as "Kit Collected"
				(
						displaytrue = "Yes"
						displayfalse = "No"
				)
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Team_Size as "Team Size"
				Preferred_Session_Date as "Preferred Session Date"
				(
					displayformat = fulldate
				)
				Preferred_Session_Slot as "Preferred Session Slot"
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Expectations_from_Event as "Expectations from Event"
				Areas_of_Interest as "Areas of Interest"
				(
					delimiter = comma
				)
				Agree_to_Code_of_Conduct as "Agree to Code of Conduct"
				(
					delimiter = comma
				)
			)
			filters
			(
				Payment_Status
				Status
				"Paid Registrations"  :  Payment_Status == "Paid"
				"Pending Payment"  :  Payment_Status == "Pending"
				"Confirmed"  :  Status == "Confirmed"
				"Checked-In"  :  Status == "Checked-In"
			)
			sort by
			(
				Participant_Name.first_name ascending
			)
		}
		list Attendance_Report
		{
			displayName = "Attendance Report"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
	 			(
	      			displayformat = [first_name+""+last_name]
	 			)
				Email
				Contact_Number as "Contact Number"
				(
					displayformat = formattednumber 
				)
				Organization_Name as "Organization Name"
				Attendance_Status as "Attendance Status"
				Kit_Collected as "Kit Collected"
				(
						displaytrue = "Yes"
						displayfalse = "No"
				)
				Status
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Team_Size as "Team Size"
				Preferred_Session_Date as "Preferred Session Date"
				(
					displayformat = fulldate
				)
				Preferred_Session_Slot as "Preferred Session Slot"
			)
			filters
			(
				Attendance_Status
				Kit_Collected
				"Present"  :  Attendance_Status == "Present"
				"Absent"  :  Attendance_Status == "Absent"
				"Not Marked"  :  Attendance_Status == "Not Marked"
				"Kit Collected"  :  Kit_Collected == true
			)
			sort by
			(
				Attendance_Status ascending
			)
		}
		kanban Status_Tracking_Report
		{
			displayName = "Status Tracking Report"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
	 			(
	      			displayformat = [first_name+""+last_name]
	 			)
				Email
				Contact_Number as "Contact Number"
				(
					displayformat = formattednumber 
				)
				Organization_Name as "Organization Name"
				Status
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Kit_Collected as "Kit Collected"
				(
						displaytrue = "Yes"
						displayfalse = "No"
				)
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Team_Size as "Team Size"
				Preferred_Session_Date as "Preferred Session Date"
				(
					displayformat = fulldate
				)
				Preferred_Session_Slot as "Preferred Session Slot"
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
			filters
			(
				Status
				Payment_Status
				"Pending Payment"  :  Status == "Pending Payment"
				"Confirmed"  :  Status == "Confirmed"
				"Checked-In"  :  Status == "Checked-In"
				"No Show"  :  Status == "No Show"
			)
			sort by
			(
				Status ascending
			)
			options
			(
	 			display field = Status
	 		)
		}
		kanban Registration_Status_Kanban
		{
			displayName = "Registration Status Kanban"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				Preferred_Session_Date as "Preferred Session Date"
				(
					displayformat = fulldate
				)
			)
			options
			(
	 			display field = Status
	 		)
		}
		list Track_By_ParticipantType_Pivot
		{
			displayName = "Track By Participant Type Pivot"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				(
					display = total	
				)
			)
		}
		calendar Session_Schedule_Calendar
		{
			displayName = "Session Schedule Calendar"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				Preferred_Session_Date as "Preferred Session Date"
				(
					displayformat = fulldate
				)
				Preferred_Session_Slot as "Preferred Session Slot"
			)
			options
			(
				display field = Participant_Name
				start date = Preferred_Session_Date
			)
		}
		list Track_Popularity_Chart
		{
			displayName = "Track Popularity Chart"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				(
					display = total	
				)
			)
		}
		list Institution_Wise_Summary
		{
			displayName = "Institution Wise Summary"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				(
					display = total	
				)
			)
			group by
			(
				Organization_Name ascending
			)
		}
		map Participant_Institution_Map
		{
			displayName = "Participant Institution Map"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				Institution_Address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
			)
			options
			(
	 			display field = Institution_Address
		 		radius = 50 Kms
	 		)
		}
		timeline Registration_Activity_Timeline
		{
			displayName = "Registration Activity Timeline"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				Added_Time as "Added Time"
				(
					displayformat = fulldate
				)
			)
			options
			(
				display field = Participant_Name
				start date = Added_Time
			)
		}
		spreadsheet Registrations_Spreadsheet
		{
			displayName = "Registrations Spreadsheet"
			show all rows from Event_Registration_Form    
			(
				Participant_Name  as "Participant Name"
				Email
				Event_Track as "Event Track"
				Participant_Type as "Participant Type"
				Payment_Status as "Payment Status"
				Attendance_Status as "Attendance Status"
				Status
				Organization_Name as "Organization Name"
				Team_Size as "Team Size"
				(
					display = total	
				)
				Preferred_Session_Date as "Preferred Session Date"
				(
					displayformat = fulldate
				)
			)
		}
	}
	pages
	{
		page Event_Command_Center_Page
		{
			displayname = "Event Command Center Page"
			Content="<zml    \n\t\t\tisPdfEnabled='true'\n\t\t\n\t\t\tisPrintEnabled='true'\n\t\t\n\t\t\tbgColor='#00D9B1'\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Event_Command_Center_.title-bar.tinted.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'theme:10'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '50%'\n>\n\t<text \n\n\tmarginRight = '10px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Normal Text'\n>\n</text>\n\n</pc><pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme:75'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Event Command Center'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='24%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Track_Popularity_Chart'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'All_Registrations_List'\n\t\ttarget = 'new-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttext ='All_Registrations_List'\n\t\tbgColor = '#0072F4'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<gauge \n\telementName='Gauge 1'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tdisplayType = 'actual'\n\ttype = '3'\n\tvalue = 'thisapp.Event_Registration_Form.Team_Size.avg'\n\t\tcriteria = 'Attendance_Status == &quot;Present&quot;'\n>\n<target size=\"15px\" color=\"#7F7F7F\" fontFamily=\"default\" value=\"2\"\n/><ranges>\n\t\t\t<range color=\"#2D72FF\" width=\"50\" />\n\t\t<range color=\"#FF6C2D\" width=\"50\" />\n</ranges><maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"5\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<board\n    \n\tbgColor = '#FFFFFF'\n        bgColorType = 'solid'\n\tpadding = '0px'\nelementName='Board'\n    layoutType = 'grid'\n        items = '1'\n    appLinkName = 'thisapp'\n    formLinkName = 'Event_Registration_Form'\n    rankBy = 'ID'\n    rankOrder = 'highestToLowest'\n    rankAggregate = 'count'\n    limit = '3'\n    groupBy = 'Event_Track'\n>\n<boardHeader>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '14px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '14px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#000000'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Course Completion by Department'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</boardHeader>\n<boa